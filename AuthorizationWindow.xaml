<Window x:Class="ShoeStore_ChebodaevKirill.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Авторизация" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Height="100" Margin="10" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="Resources/icon.png" Width="80" Height="80" Margin="0,0,20,0"/>
                <TextBlock Text="Авторизация" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Логин" Margin="0,10,0,5"/>
            <TextBox x:Name="TbLogin" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="PbPassword" Height="30" Margin="0,0,0,20"/>

            <Button Content="Войти" Height="35" Background="#00FA9A" Click="BtnLogin_Click" Margin="0,0,0,10"/>
            <Button Content="Войти как гость" Height="35" Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>
